{
	"name": "forgeframe",
	"version": "2.1.0",
	"description": "Modern cross-domain iframe component framework - a TypeScript alternative to zoid",
	"type": "module",
	"module": "./dist/forgeframe.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/forgeframe.js",
			"default": "./dist/forgeframe.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.js",
			"default": "./dist/react.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "node -e \"require('node:fs').copyFileSync('../../README.md', 'README.md')\" && vite build && tsc --emitDeclarationOnly && node scripts/fix-dts-imports.mjs",
		"typecheck": "tsc --noEmit && npm run typecheck:tests",
		"typecheck:tests": "tsc -p tests/typecheck/tsconfig.json --noEmit && tsc -p tests/unit/tsconfig.json --noEmit && tsc -p tests/integration/tsconfig.json --noEmit && tsc -p tests/browser/tsconfig.json --noEmit",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"size": "node scripts/check-bundle-size.mjs",
		"prepublishOnly": "npm run release:check --prefix ../..",
		"test:browser": "playwright test"
	},
	"keywords": [
		"iframe",
		"cross-domain",
		"component",
		"zoid",
		"postmessage",
		"popup",
		"embed"
	],
	"author": "Josh Smith",
	"license": "MIT",
	"homepage": "https://github.com/jshsmth/forgeframe#readme",
	"bugs": {
		"url": "https://github.com/jshsmth/forgeframe/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jshsmth/forgeframe.git"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"valibot": "^1.5.0",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"@types/react": ">=16.8.0",
		"react": ">=16.8.0"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	}
}
