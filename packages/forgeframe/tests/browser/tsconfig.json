{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"rootDir": "../..",
		"declaration": false,
		"isolatedDeclarations": false,
		"emitDeclarationOnly": false,
		/* Typecheck the fixtures' public specifiers against the source. */
		"paths": {
			"@/*": ["../../src/*"],
			"forgeframe": ["../../src/index.ts"],
			"forgeframe/react": ["../../src/react.ts"]
		}
	},
	"include": ["./*.ts", "../../playwright.config.ts"]
}
